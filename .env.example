# Supabase Configuration (Free Tier)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-Side Only Discord Webhook (Set in Netlify Environment Variables)
# Paste your Discord channel webhook URL here for instant notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-token

# Optional Client-Side Discord Webhook Fallback (For local dev without Netlify Functions)
VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-token

# Optional Cloudflare Turnstile Bot Protection
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...
